@model StudentDashboardViewModel
@{ ViewData["Title"] = "Student Dashboard"; }
<div class="page-heading d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4"><div><h1>Academic Project Repository</h1>
<p class="lead mb-1">Welcome, @Model.Profile.FullName</p>
<p class="text-muted mb-0">@Model.Profile.Department · @string.Join(", ", Model.Profile.Roles)</p></div>
<a class="btn btn-primary" asp-controller="StudentSubmissions" asp-action="Create">New Submission</a></div>
<div class="row g-3 mb-4">
<div class="col-6 col-lg-4 col-xxl-2"><div class="card card-body"><span>My Submissions</span><strong data-summary="total">@Model.Total</strong></div></div>
<div class="col-6 col-lg-4 col-xxl-2"><div class="card card-body"><span>Drafts</span><strong data-summary="drafts">@Model.Drafts</strong></div></div>
<div class="col-6 col-lg-4 col-xxl-2"><div class="card card-body"><span>Submitted</span><strong data-summary="submitted">@Model.Submitted</strong></div></div>
<div class="col-6 col-lg-4 col-xxl-2"><div class="card card-body"><span>Approved</span><strong data-summary="approved">@Model.Approved</strong></div></div>
<div class="col-6 col-lg-4 col-xxl-2"><div class="card card-body"><span>Rejected / Revision Required</span><strong data-summary="rejected">@Model.Rejected</strong></div></div>
<div class="col-6 col-lg-4 col-xxl-2"><div class="card card-body"><span>Revisions in Progress</span><strong data-summary="revisions">@Model.Revisions</strong></div></div>
</div>
<div class="d-flex justify-content-between align-items-center gap-2 mb-3"><h2 class="h4 mb-0">My Recent Submissions</h2><a class="btn btn-outline-primary btn-sm" asp-controller="StudentSubmissions" asp-action="Index">View all</a></div>
<partial name="_SubmissionTable" model="Model.Recent" />
