@model InstitutionRepositoryReport
@{ ViewData["Title"] = "ORIC / QEC Dashboard"; }
<h1>ORIC / QEC Dashboard</h1><p>Welcome, @User.Identity?.Name</p>
<p>Role: ORICQEC · Institution-wide Academic Repository Access · Read-only</p>
<h2 class="h4">Academic Repository Overview</h2>
<div class="row g-3 mb-4">
<div class="col"><div class="card card-body"><span>Total Approved Projects</span><strong data-insight="approved">@Model.Total</strong></div></div>
<div class="col"><div class="card card-body"><span>Approved This Academic Year (@Model.CurrentAcademicYear)</span><strong data-insight="current-year">@Model.CurrentAcademicYearCount</strong></div></div>
<div class="col"><div class="card card-body"><span>Active Departments</span><strong>@Model.ActiveDepartmentCount</strong></div></div>
@foreach (var type in Enum.GetValues<ProjectType>())
{
<div class="col"><div class="card card-body"><span>@Html.DisplayFor(_ => type)</span><strong data-type="@((int)type)">@(Model.ProjectTypes.SingleOrDefault(t => t.Type == type)?.Count ?? 0)</strong></div></div>
}
</div>
@if (Model.HasUnavailableRecords) { <p class="alert alert-warning">Incomplete or unavailable approved records have been withheld from repository statistics and reports. Contact your administrator.</p> }
<a class="btn btn-primary mb-3" asp-action="Repository">Academic Repository</a> <a class="btn btn-outline-primary mb-3" asp-action="Reports">Reports</a>
<h2 class="h4">Approved Projects by Department</h2>
<table class="table"><thead><tr><th>Department</th><th>Approved Projects</th></tr></thead><tbody>
@foreach (var department in Model.Departments) { <tr><td>@department.Department</td><td>@department.Total</td></tr> }
</tbody></table>
<h2 class="h4">Recent Approvals</h2>
@if (Model.Recent.Count == 0) { <p>No approved projects available.</p> }
@foreach (var item in Model.Recent)
{
<article class="card mb-3"><div class="card-body"><h3 class="h5"><a asp-action="Details" asp-route-id="@item.SubmissionId">@item.Title</a></h3><p class="mb-0">@item.Department · Student: @item.StudentName · Approved (UTC): @item.ApprovedAt.ToString("u")</p></div></article>
}
