@model DepartmentRepositoryStats
@{ ViewData["Title"] = "Department Head Dashboard"; }
<h1>Department Head Dashboard</h1><h2>@Model.Department</h2>
<p>Role: DepartmentHead · Read-only approved academic repository</p>
<div class="row g-3 mb-4">
<div class="col"><div class="card card-body"><span>Approved Repository Projects</span><strong data-insight="approved">@Model.Total</strong></div></div>
@foreach (var type in Enum.GetValues<ProjectType>())
{
<div class="col"><div class="card card-body"><span>@Html.DisplayFor(_ => type)</span><strong data-type="@((int)type)">@(Model.ProjectTypes.SingleOrDefault(t => t.Type == type)?.Count ?? 0)</strong></div></div>
}
<div class="col"><div class="card card-body"><span>Approved This Academic Year (@Model.CurrentAcademicYear)</span><strong data-insight="current-year">@Model.CurrentAcademicYearCount</strong></div></div>
</div>
<a class="btn btn-primary mb-4" asp-action="Repository">Academic Repository</a>
@if (Model.HasUnavailableRecords) { <p class="alert alert-warning">Some department approvals are incomplete or unavailable and are withheld from repository views.</p> }
<h2 class="h4">Repository Insights</h2>
<p class="text-muted">Counts include approved records with valid submitted-version and resource snapshots. Physical resource availability is checked when repository entries are displayed or downloaded.</p>
<div class="row"><div class="col-md-6"><h3 class="h5">Approved Projects by Academic Year</h3><table class="table"><thead><tr><th>Academic Year</th><th>Approved Projects</th></tr></thead><tbody>
@foreach (var group in Model.AcademicYears) { <tr><td>@group.Label</td><td>@group.Count</td></tr> }
</tbody></table></div><div class="col-md-6"><h3 class="h5">Approved Projects by Semester</h3><table class="table"><thead><tr><th>Semester</th><th>Approved Projects</th></tr></thead><tbody>
@foreach (var group in Model.Semesters) { <tr><td>@group.Label</td><td>@group.Count</td></tr> }
</tbody></table></div></div>
<h2 class="h4">Recent Approved Projects</h2>
@if (Model.Recent.Count == 0) { <p>No approved projects available.</p> }
@foreach (var item in Model.Recent)
{
<article class="card mb-3"><div class="card-body"><h3 class="h5"><a asp-controller="Repository" asp-action="Details" asp-route-id="@item.SubmissionId">@item.Title</a></h3><p class="mb-0">Student: @item.StudentName · Student ID: @item.StudentNumber · Approved (UTC): @item.ApprovedAt.ToString("u")</p></div></article>
}
