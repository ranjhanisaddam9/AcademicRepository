@model CreateSubmissionViewModel
@{ ViewData["Title"] = "New Submission"; }
<div class="page-heading mb-4"><h1>New Submission</h1><p class="text-muted mb-0">Create a draft of your academic project. Required fields are marked on the form.</p></div>
<form asp-action="Create" method="post" class="section-card" style="max-width:900px">
<partial name="_Fields" model="Model" />
<button class="btn btn-secondary" name="intent" value="SaveDraft" type="submit">Save Draft</button>
<p class="form-text mt-2">Save a draft, then upload at least one resource before submitting.</p>
<a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
</form>
