@model EditSubmissionViewModel
@{ ViewData["Title"] = "Edit Draft"; }
<h1>Edit Draft</h1>
<form asp-action="Edit" asp-route-id="@ViewContext.RouteData.Values["id"]" method="post" style="max-width:850px">
<input asp-for="EditToken" type="hidden" />
<partial name="_Fields" model="Model" />
<button class="btn btn-secondary" name="intent" value="SaveDraft" type="submit">Save Draft</button>
<button class="btn btn-primary" name="intent" value="Submit" type="submit">Submit</button>
<a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
</form>
@await Component.InvokeAsync("ProjectResources", new { submissionId = int.Parse(ViewContext.RouteData.Values["id"]!.ToString()!) })
