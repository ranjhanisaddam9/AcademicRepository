@model IReadOnlyList<SubmissionListViewModel>
<div class="table-responsive"><table class="table table-striped"><thead><tr><th>Title</th><th>Type</th><th>Department</th><th>Created (UTC)</th><th>Submitted (UTC)</th><th>Status</th><th>Actions</th></tr></thead><tbody>
@foreach (var submission in Model)
{
    <tr><td>@submission.Title</td><td>@Html.DisplayFor(_ => submission.ProjectType)</td><td>@submission.Department</td><td>@submission.CreatedAt.ToString("u")</td><td>@(submission.SubmittedAt?.ToString("u") ?? "Not submitted")</td><td><partial name="_SubmissionStatus" model="submission.Status" /></td><td>
    <a asp-controller="StudentSubmissions" asp-action="Details" asp-route-id="@submission.Id">@(submission.Status == SubmissionStatus.Rejected ? "View Feedback / Start Revision" : "View")</a>
    @if (submission.Status == SubmissionStatus.Revision) { <span> | </span><a asp-controller="StudentSubmissions" asp-action="Edit" asp-route-id="@submission.Id">Edit / Manage Resources / Resubmit</a> }
    @if (submission.Status == SubmissionStatus.Draft)
    {
        <span> | </span><a asp-controller="StudentSubmissions" asp-action="Edit" asp-route-id="@submission.Id">Edit</a>
        <span> | </span><a asp-controller="StudentSubmissions" asp-action="Delete" asp-route-id="@submission.Id">Delete</a>
    }
    </td></tr>
}
</tbody></table></div>
@if (Model.Count == 0) { <p>No submissions yet.</p> }
