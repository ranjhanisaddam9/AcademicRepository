<dialog class="action-confirm-dialog" aria-labelledby="confirm-dialog-title" aria-describedby="confirm-dialog-message" data-confirm-dialog>
    <div class="action-confirm-content">
        <h2 id="confirm-dialog-title" class="h4">Confirm action</h2>
        <p id="confirm-dialog-message" data-confirm-message>This action may affect saved work.</p>
        <div class="d-flex flex-wrap justify-content-end gap-2">
            <button type="button" class="btn btn-outline-secondary" data-confirm-cancel>Cancel</button>
            <button type="button" class="btn btn-danger" data-confirm-accept>Continue</button>
        </div>
    </div>
</dialog>
