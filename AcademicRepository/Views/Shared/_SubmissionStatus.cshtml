@model SubmissionStatus
@{
    var css = Model switch { SubmissionStatus.Draft => "bg-secondary", SubmissionStatus.Submitted => "bg-primary", SubmissionStatus.Approved => "bg-success", SubmissionStatus.Rejected => "bg-danger", SubmissionStatus.Revision => "bg-warning", _ => "bg-warning" };
    var label = Model == SubmissionStatus.UnderReview ? "Under Review" : Model.ToString();
}
@{ var badge = new StatusBadgeViewModel(label, $"status-badge {css}"); }
<partial name="_StatusBadge" model="badge" />
