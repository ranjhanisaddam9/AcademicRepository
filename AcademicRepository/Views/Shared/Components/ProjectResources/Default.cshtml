@model ResourceListViewModel
<section class="mt-4 border-top pt-3">
<h2>Resource Materials</h2>
@if (Model.CanManage)
{
<p>Save any project edits before uploading. Up to @Model.MaxFilesPerSubmission files, @Model.MaxFileSizeMB MB each.</p>
<form asp-controller="ProjectFiles" asp-action="Upload" asp-route-id="@Model.SubmissionId" method="post" enctype="multipart/form-data" style="max-width:850px">
<div class="mb-3"><label for="resource-type" class="form-label">Resource Type</label><select id="resource-type" name="ResourceType" asp-items="Html.GetEnumSelectList<ProjectResourceType>()" class="form-select" required><option value="">Select a resource type</option></select></div>
<div class="mb-3"><label for="resource-description" class="form-label">Description (optional)</label><textarea id="resource-description" name="Description" maxlength="1000" class="form-control"></textarea></div>
<div class="mb-3"><label for="resource-file" class="form-label">File</label><input id="resource-file" name="File" type="file" class="form-control" accept="@string.Join(",", AcademicRepository.Services.ResourceFileValidator.ContentTypes.Keys)" required /></div>
<button class="btn btn-primary" type="submit">Upload Resource</button>
</form>
}
else { <p>This submission is read-only. You may download your resources.</p> }
<h3 class="h5 mt-3">Uploaded Resources</h3>
@if (Model.Files.Count == 0) { <p>No resources uploaded.</p> }
else
{
<div class="table-responsive"><table class="table"><thead><tr><th>File</th><th>Resource Type</th><th>Description</th><th>Size</th><th>Uploaded (UTC)</th><th>Actions</th></tr></thead><tbody>
@foreach (var file in Model.Files)
{
<tr><td>@file.OriginalFileName</td><td>@Html.DisplayFor(_ => file.ResourceType)</td><td>@file.Description</td><td>@file.DisplaySize</td><td>@file.UploadedAt.ToString("u")</td><td>
<a asp-controller="ProjectFiles" asp-action="Download" asp-route-id="@file.Id" class="btn btn-sm btn-outline-primary">Download</a>
@if (Model.CanManage) { <form class="d-inline" asp-controller="ProjectFiles" asp-action="Delete" asp-route-id="@file.Id" method="post"><button class="btn btn-sm btn-outline-danger" type="submit">Delete</button></form> }
</td></tr>
}
</tbody></table></div>
}
</section>
