@model DashboardViewModel
@{ ViewData["Title"] = "Dashboard"; }
<h1>Academic Project Repository</h1>
<p>Welcome, @Model.FullName</p>
<p>Role: @(Model.Roles.Count == 0 ? "No role assigned" : string.Join(", ", Model.Roles))</p>
<p>Department: @Model.Department</p>
@if (Model.DepartmentCount.HasValue)
{
    <h2>Administration</h2>
    <div class="row g-3">
        <div class="col-sm-6"><div class="card card-body"><h3>Departments: @Model.DepartmentCount</h3><a asp-controller="Departments" asp-action="Index">Manage Departments</a></div></div>
        <div class="col-sm-6"><div class="card card-body"><h3>Users: @Model.UserCount</h3><a asp-controller="Users" asp-action="Index">Manage Users</a></div></div>
    </div>
}
