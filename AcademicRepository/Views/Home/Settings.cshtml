@model OperationalSettingsViewModel
@{ ViewData["Title"] = "Operational Settings"; }
<h1>Operational settings</h1><p>Validated values apply at runtime. Secrets and infrastructure credentials are managed through deployment configuration and cannot be changed here.</p>
<form asp-action="Settings" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><input asp-for="ConcurrencyToken" type="hidden" />
<div class="mb-3"><label asp-for="ApplicationDisplayName" class="form-label"></label><input asp-for="ApplicationDisplayName" class="form-control" /><span asp-validation-for="ApplicationDisplayName" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="SupportEmail" class="form-label"></label><input asp-for="SupportEmail" class="form-control" /><span asp-validation-for="SupportEmail" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="DefaultAcademicYear" class="form-label"></label><input asp-for="DefaultAcademicYear" class="form-control" /><span asp-validation-for="DefaultAcademicYear" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="MaxFileSizeMB" class="form-label"></label><input asp-for="MaxFileSizeMB" class="form-control" /><span asp-validation-for="MaxFileSizeMB" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="MaxFilesPerSubmission" class="form-label"></label><input asp-for="MaxFilesPerSubmission" class="form-control" /><span asp-validation-for="MaxFilesPerSubmission" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="OtpExpiryMinutes" class="form-label"></label><input asp-for="OtpExpiryMinutes" class="form-control" /><span asp-validation-for="OtpExpiryMinutes" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="OtpMaxAttempts" class="form-label"></label><input asp-for="OtpMaxAttempts" class="form-control" /><span asp-validation-for="OtpMaxAttempts" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="OtpResendCooldownSeconds" class="form-label"></label><input asp-for="OtpResendCooldownSeconds" class="form-control" /><span asp-validation-for="OtpResendCooldownSeconds" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="RepositoryPageSize" class="form-label"></label><select asp-for="RepositoryPageSize" class="form-select"><option value="10">10</option><option value="20">20</option><option value="50">50</option><option value="100">100</option></select><span asp-validation-for="RepositoryPageSize" class="text-danger"></span></div>
<p>Last updated: @(Model.UpdatedAt?.ToString("u") ?? "Never") by @(Model.UpdatedBy ?? "—")</p><button class="btn btn-primary">Save settings</button></form>
