@model DataConsistencyViewModel
@{ ViewData["Title"] = "Data Diagnostics"; }
<h1>Data consistency diagnostics</h1><p>Read-only inspection completed @Model.CheckedAtUtc.ToString("u"). No repair actions are performed.</p><p>Orphan physical files: <strong>@Model.OrphanFileCount</strong>. File paths are withheld.</p>
@if(Model.Issues.Count == 0){<p class="alert alert-success">No consistency issues found.</p>}else{<div class="table-responsive" tabindex="0" role="region" aria-label="Data consistency issues"><table class="table"><thead><tr><th>Category</th><th>Record</th><th>Finding</th></tr></thead><tbody>@foreach(var issue in Model.Issues){<tr><td>@issue.Category</td><td>@issue.Record</td><td>@issue.Description</td></tr>}</tbody></table></div>}
