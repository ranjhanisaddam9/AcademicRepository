@model ReviewDetailsViewModel
@{ ViewData["Title"] = "Submission Review"; }
<h1>@Model.Project.Title</h1>
<p><partial name="_SubmissionStatus" model="Model.Project.Status" /></p>
<h2 class="h4">Student</h2>
<dl class="row">
<dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.Project.StudentName</dd>
<dt class="col-sm-3">Student ID</dt><dd class="col-sm-9">@(Model.StudentNumber ?? "Not recorded")</dd>
<dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd>
<dt class="col-sm-3">Department</dt><dd class="col-sm-9">@Model.Project.Department</dd>
</dl>
<h2 class="h4">Project</h2><dl class="row">
<dt class="col-sm-3">Project Type</dt><dd class="col-sm-9">@Html.DisplayFor(m => m.Project.ProjectType)</dd>
<dt class="col-sm-3">Abstract</dt><dd class="col-sm-9" style="white-space:pre-wrap">@Model.Project.Abstract</dd>
<dt class="col-sm-3">Keywords</dt><dd class="col-sm-9">@Model.Project.Keywords</dd>
<dt class="col-sm-3">Supervisor</dt><dd class="col-sm-9">@Model.Project.SupervisorName</dd>
<dt class="col-sm-3">Course Name</dt><dd class="col-sm-9">@Model.Project.CourseName</dd>
<dt class="col-sm-3">Course Code</dt><dd class="col-sm-9">@Model.Project.CourseCode</dd>
<dt class="col-sm-3">Academic Year</dt><dd class="col-sm-9">@Model.Project.AcademicYear</dd>
<dt class="col-sm-3">Semester</dt><dd class="col-sm-9">@Model.Project.Semester</dd>
<dt class="col-sm-3">Created (UTC)</dt><dd class="col-sm-9">@Model.Project.CreatedAt.ToString("u")</dd>
<dt class="col-sm-3">Submitted (UTC)</dt><dd class="col-sm-9">@Model.Project.SubmittedAt?.ToString("u")</dd>
</dl>
<h2 class="h4">Resource Materials</h2>
@if (Model.Files.Count == 0) { <p class="alert alert-warning">No resources are attached to this legacy submission.</p> }
else
{
<div class="table-responsive"><table class="table"><thead><tr><th>File</th><th>Type</th><th>Description</th><th>Size</th><th>Uploaded (UTC)</th><th>Action</th></tr></thead><tbody>
@foreach (var file in Model.Files) { <tr><td>@file.OriginalFileName</td><td>@Html.DisplayFor(_ => file.ResourceType)</td><td>@file.Description</td><td>@file.DisplaySize</td><td>@file.UploadedAt.ToString("u")</td><td><a asp-action="Download" asp-route-id="@file.Id">Download</a></td></tr> }
</tbody></table></div>
}
<h2 class="h4 mt-4">Review</h2>
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
@if (Model.WorkflowMessage is not null) { <p class="alert alert-warning">@Model.WorkflowMessage</p> }
@if (Model.CanStart)
{
<form asp-action="StartReview" asp-route-id="@Model.Project.Id" method="post"><button class="btn btn-primary" type="submit">Start Review</button></form>
}
@if (Model.CanComplete)
{
<form asp-action="Approve" asp-route-id="@Model.Project.Id" method="post" style="max-width:850px">
<input type="hidden" name="ReviewId" value="@Model.ActiveReviewId" />
<label for="review-comments" class="form-label">Comments (required for rejection)</label>
<textarea id="review-comments" name="Comments" maxlength="2000" class="form-control mb-3" rows="4">@ViewData["Comments"]</textarea>
<button class="btn btn-success" type="submit">Approve</button>
<button class="btn btn-danger" type="submit" asp-action="Reject" asp-route-id="@Model.Project.Id">Reject</button>
</form>
}
<partial name="_ReviewHistory" model="Model.History" />
@await Component.InvokeAsync("SubmissionVersions", new { submissionId = Model.Project.Id })
<a class="btn btn-secondary" asp-action="ReviewQueue">Back to Review Queue</a>
