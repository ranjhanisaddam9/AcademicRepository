@model ReviewListViewModel
@{ ViewData["Title"] = Model.QueueOnly ? "Review Queue" : "Department Submissions"; var action = Model.QueueOnly ? "ReviewQueue" : "Submissions"; }
<h1>@ViewData["Title"]</h1><p class="lead">Department: @Model.Profile.Department</p>
<form method="get" asp-action="@action" class="row g-2 mb-4">
<div class="col-md-3"><label for="review-search" class="form-label">Title, Student Name or Student ID</label><input id="review-search" name="Search" value="@Model.Filter.Search" maxlength="200" class="form-control" /></div>
<div class="col-md-2"><label for="review-status" class="form-label">Status</label><select id="review-status" name="Status" class="form-select"><option value="">All @(Model.QueueOnly ? "in queue" : "review statuses")</option>
@foreach (var status in Enum.GetValues<SubmissionStatus>().Where(s => s is not (SubmissionStatus.Draft or SubmissionStatus.Revision) && (!Model.QueueOnly || s is SubmissionStatus.Submitted or SubmissionStatus.UnderReview)))
{ <option value="@((int)status)" selected="@(Model.Filter.Status == status)">@(status == SubmissionStatus.Submitted ? "Awaiting Review" : status == SubmissionStatus.UnderReview ? "Under Review" : status.ToString())</option> }
</select></div>
<div class="col-md-2"><label for="review-type" class="form-label">Project Type</label><select id="review-type" name="ProjectType" class="form-select"><option value="">All types</option>
@foreach (var type in Html.GetEnumSelectList<ProjectType>()) { <option value="@type.Value" selected="@(Model.Filter.ProjectType.HasValue && ((int)Model.Filter.ProjectType.Value).ToString() == type.Value)">@type.Text</option> }
</select></div>
<div class="col-md-2"><label for="review-year" class="form-label">Academic Year</label><input id="review-year" name="AcademicYear" value="@Model.Filter.AcademicYear" maxlength="30" class="form-control" /></div>
<div class="col-md-2"><label for="review-semester" class="form-label">Semester</label><input id="review-semester" name="Semester" value="@Model.Filter.Semester" maxlength="50" class="form-control" /></div>
<div class="col-md-1 d-flex align-items-end"><button class="btn btn-primary" type="submit">Filter</button></div>
</form>
<p>@Model.Total matching submissions · Page @Model.Filter.Page of @Model.PageCount</p>
<partial name="_ReviewQueueTable" model="Model.Items" />
<nav aria-label="Submission pages">
@if (Model.Filter.Page > 1) { <a class="btn btn-outline-secondary" asp-action="@action" asp-route-Page="@(Model.Filter.Page - 1)" asp-route-Status="@Model.Filter.Status" asp-route-ProjectType="@Model.Filter.ProjectType" asp-route-AcademicYear="@Model.Filter.AcademicYear" asp-route-Semester="@Model.Filter.Semester" asp-route-Search="@Model.Filter.Search">Previous</a> }
@if (Model.Filter.Page < Model.PageCount) { <a class="btn btn-outline-secondary" asp-action="@action" asp-route-Page="@(Model.Filter.Page + 1)" asp-route-Status="@Model.Filter.Status" asp-route-ProjectType="@Model.Filter.ProjectType" asp-route-AcademicYear="@Model.Filter.AcademicYear" asp-route-Semester="@Model.Filter.Semester" asp-route-Search="@Model.Filter.Search">Next</a> }
</nav>
