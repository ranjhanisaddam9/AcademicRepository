@model ReviewListViewModel
@{
    ViewData["Title"] = Model.QueueOnly ? "Review Queue" : "Department Submissions";
    var action = Model.QueueOnly ? "ReviewQueue" : "Submissions";
    var filterModel = Model.Filter;
    var statusOptions = new[] { new FilterOptionViewModel("", Model.QueueOnly ? "All in queue" : "All review statuses") }
        .Concat(Enum.GetValues<SubmissionStatus>().Where(s => s is not (SubmissionStatus.Draft or SubmissionStatus.Revision) && (!Model.QueueOnly || s is SubmissionStatus.Submitted or SubmissionStatus.UnderReview)).Select(s => new FilterOptionViewModel(s.ToString(), s == SubmissionStatus.Submitted ? "Awaiting Review" : s == SubmissionStatus.UnderReview ? "Under Review" : s.ToString()))).ToArray();
    var typeOptions = new[] { new FilterOptionViewModel("", "All types") }.Concat(Enum.GetValues<ProjectType>().Select(t => new FilterOptionViewModel(t.ToString(), t.ToString()))).ToArray();
    var fields = new FilterFieldViewModel[]
    {
        new("Search", "Title, Student name or Student ID", filterModel.Search, "search", "Search department submissions", 200),
        new("Status", "Status", filterModel.Status?.ToString() ?? "", "select", Options: statusOptions),
        new("ProjectType", "Project Type", filterModel.ProjectType?.ToString() ?? "", "select", Options: typeOptions),
        new("AcademicYear", "Academic Year", filterModel.AcademicYear, MaxLength: 30),
        new("Semester", "Semester", filterModel.Semester, MaxLength: 50),
        new("Sort", "Sort by", filterModel.Sort, "select", Options: new[] { new FilterOptionViewModel("SubmittedAt", "Submission date"), new("Title", "Title"), new("Student", "Student"), new("Status", "Status"), new("Type", "Project type") }),
        new("Direction", "Direction", filterModel.Direction, "select", Options: new[] { new FilterOptionViewModel("desc", "Descending"), new("asc", "Ascending") })
    };
    var filter = new FilterPanelViewModel(action, "Coordinator", action, fields, Model.Results.PageSize);
    var route = new Dictionary<string, string> { ["Status"] = filterModel.Status?.ToString() ?? "", ["ProjectType"] = filterModel.ProjectType?.ToString() ?? "", ["AcademicYear"] = filterModel.AcademicYear ?? "", ["Semester"] = filterModel.Semester ?? "", ["Search"] = filterModel.Search ?? "", ["Sort"] = filterModel.Sort, ["Direction"] = filterModel.Direction, ["pageSize"] = Model.Results.PageSize.ToString() };
    var rows = Model.Items.Select(s => new DataTableRowViewModel(new DataTableCellViewModel[]
    {
        new(s.Title), new(s.StudentName), new(s.StudentNumber ?? "Not recorded"), new(s.ProjectType.ToString()), new(s.AcademicYear ?? "—"), new(s.Semester ?? "—"), new(s.SubmittedAt?.ToString("u") ?? "—"),
        new(s.Status == SubmissionStatus.Submitted ? "Awaiting Review" : s.Status == SubmissionStatus.UnderReview ? "Under Review" : s.Status.ToString(), s.Status == SubmissionStatus.Approved ? "bg-success" : s.Status == SubmissionStatus.Rejected ? "bg-danger" : s.Status == SubmissionStatus.UnderReview ? "bg-primary" : "bg-info text-dark")
    }, new[] { new DataTableActionViewModel("Open", Url.Action("Review", "Coordinator", new { id = s.Id }) ?? "#") })).ToArray();
    var table = new DataTableViewModel(action, "Coordinator", new[] { new DataTableColumnViewModel("Title", "Title"), new("Student Name", "Student"), new("Student ID"), new("Project Type", "Type"), new("Academic Year"), new("Semester"), new("Submitted (UTC)", "SubmittedAt"), new("Status", "Status") }, rows, filterModel.Sort, filterModel.Direction, route, "No matching submissions", "No department submissions match these filters.", Url.Action(action, "Coordinator"));
    var pagination = new PaginationViewModel(action, "Coordinator", Model.Results.PageNumber, Model.Results.PageSize, Model.Results.TotalCount, "Department submissions", route);
}
<h1>@ViewData["Title"]</h1><p class="lead">Department: @Model.Profile.Department</p>
<partial name="_FilterPanel" model="filter" />
<partial name="_DataTable" model="table" />
<partial name="_Pagination" model="pagination" />
