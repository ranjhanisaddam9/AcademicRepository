@model DepartmentListPageViewModel
@{
    ViewData["Title"] = "Departments";
    var page = Model.Page;
    var filter = new FilterPanelViewModel("Index", "Departments", "Index", new[] { new FilterFieldViewModel("search", "Name, code or student email code", Model.Search, "search", "Search departments", 200) }, page.PageSize);
    var route = new Dictionary<string, string> { ["search"] = Model.Search ?? "", ["sort"] = Model.Sort, ["direction"] = Model.Direction, ["pageSize"] = page.PageSize.ToString() };
    var rows = page.Items.Select(d => new DataTableRowViewModel(new DataTableCellViewModel[]
    {
        new(d.Code), new(d.Name), new(d.StudentEmailKeyword), new(d.IsActive ? "Active" : "Inactive", d.IsActive ? "bg-success" : "bg-secondary")
    }, new DataTableActionViewModel[]
    {
        new("Details", Url.Action("Details", "Departments", new { id = d.Id }) ?? "#"),
        new("Edit", Url.Action("Edit", "Departments", new { id = d.Id }) ?? "#"),
        new(d.IsActive ? "Deactivate" : "Activate", "#", "btn btn-sm btn-link text-start", "Departments", "SetActive", d.Id.ToString(), true, "isActive", (!d.IsActive).ToString().ToLowerInvariant())
    })).ToArray();
    var table = new DataTableViewModel("Index", "Departments", new[] { new DataTableColumnViewModel("Code", "Code"), new("Name", "Name"), new("Student email code"), new("Status", "Status") }, rows, Model.Sort, Model.Direction, route, "No departments found", "Try another search or create a department.", Url.Action("Index", "Departments"));
    var pagination = new PaginationViewModel("Index", "Departments", page.PageNumber, page.PageSize, page.TotalCount, "Department", route);
}
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Departments</h1><a class="btn btn-primary" asp-action="Create">Create Department</a></div>
<partial name="_FilterPanel" model="filter" />
<partial name="_DataTable" model="table" />
<partial name="_Pagination" model="pagination" />
