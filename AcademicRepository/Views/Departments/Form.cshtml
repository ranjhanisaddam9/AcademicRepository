@model DepartmentFormViewModel
@{ var editing = ViewContext.RouteData.Values["action"]?.ToString() == "Edit"; ViewData["Title"] = editing ? "Edit Department" : "Create Department"; }
<h1>@ViewData["Title"]</h1>
<form method="post" asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@ViewContext.RouteData.Values["id"]" style="max-width:600px">
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" maxlength="120" /></div>
<div class="mb-3"><label asp-for="Code" class="form-label"></label><input asp-for="Code" class="form-control" maxlength="20" /></div>
<button class="btn btn-primary">Save</button> <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>
