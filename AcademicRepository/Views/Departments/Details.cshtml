@model DepartmentDetailsViewModel
@{ ViewData["Title"] = "Department Details"; }
<h1>@Model.Name</h1>
<dl class="row"><dt class="col-sm-3">Code</dt><dd class="col-sm-9">@Model.Code</dd><dt class="col-sm-3">Status</dt><dd class="col-sm-9">@(Model.IsActive ? "Active" : "Inactive")</dd><dt class="col-sm-3">Created (UTC)</dt><dd class="col-sm-9">@Model.CreatedAt.ToString("u")</dd><dt class="col-sm-3">Updated (UTC)</dt><dd class="col-sm-9">@(Model.UpdatedAt?.ToString("u") ?? "Not updated")</dd><dt class="col-sm-3">Users</dt><dd class="col-sm-9"><a asp-controller="Users" asp-action="Index" asp-route-departmentId="@Model.Id">@Model.UserCount assigned users</a></dd></dl>
<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a> <a class="btn btn-secondary" asp-action="Index">Back</a>
