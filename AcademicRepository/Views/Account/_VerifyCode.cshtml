@model VerifyCodeViewModel
@{ var student = ViewContext.RouteData.Values["action"]?.ToString() is "StudentSignIn" or "VerifyStudentCode"; }
@if (ViewData["Status"] is string status) { <div class="alert alert-info">@status</div> }
<form asp-action="@(student ? "VerifyStudentCode" : "VerifyRecoveryCode")" method="post" style="max-width:500px">
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<input asp-for="ChallengeToken" type="hidden" /><input asp-for="Email" type="hidden" />
<div class="mb-3"><label asp-for="Code" class="form-label"></label><input asp-for="Code" class="form-control" autocomplete="one-time-code" inputmode="numeric" maxlength="6" /></div>
<button class="btn btn-primary">Verify</button></form>
<form asp-action="@(student ? "StudentSignIn" : "ForgotPassword")" method="post" class="mt-3"><input asp-for="Email" type="hidden" /><button class="btn btn-outline-secondary">Resend Code</button></form>
<a asp-action="Login">Back to Sign In</a>
