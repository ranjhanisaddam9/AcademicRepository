@model LoginViewModel
@{ ViewData["Title"] = "Login"; }
<div class="mx-auto" style="max-width:420px">
<h1>Sign In</h1>
<section class="card card-body mb-4"><h2>Student Sign In</h2><p>Use your SMIU email address. A verification code will be emailed to you.</p><a class="btn btn-outline-primary" asp-action="StudentSignIn">Student Sign In</a></section>
<h2>Staff Sign In</h2><p>For Admin, Coordinator, Department Head and ORIC / QEC. Use your assigned @@smiu.edu.pk account.</p>
<p class="small">Coordinator accounts require an assigned department. Department Head accounts also require an assigned department. Contact your administrator if your department is missing.</p>
<form asp-action="Login" method="post">
<input asp-for="ReturnUrl" type="hidden" />
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="username" /></div>
<div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="current-password" /></div>
<div class="form-check mb-3"><input asp-for="RememberMe" class="form-check-input" /><label asp-for="RememberMe" class="form-check-label">Remember me</label></div>
<button type="submit" class="btn btn-primary">Sign In</button> <a asp-action="ForgotPassword">Forgot Password</a>
</form></div>
