@model StaffResetPasswordViewModel
@{ ViewData["Title"] = "Reset Staff Password"; }
<h1>Reset Staff Password</h1>
<form asp-action="ResetStaffPassword" method="post" style="max-width:500px">
<div asp-validation-summary="All" class="text-danger" role="alert"></div><input asp-for="GrantToken" type="hidden" />
<div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="new-password" /></div>
<div class="mb-3"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /></div>
<button class="btn btn-primary">Reset Password</button></form>
