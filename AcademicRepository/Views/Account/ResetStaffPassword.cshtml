@model StaffResetPasswordViewModel
@{ ViewData["Title"] = "Reset Staff Password"; }
<section class="auth-flow-card"><h1>Reset staff password</h1><p>Choose a new password for your staff account.</p>
<form asp-action="ResetStaffPassword" method="post">
<div asp-validation-summary="All" class="text-danger" role="alert"></div><input asp-for="GrantToken" type="hidden" />
<div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Password" class="field-validation-error"></span></div>
<div class="mb-3"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="field-validation-error"></span></div>
<button class="btn btn-primary">Reset Password</button></form></section>
