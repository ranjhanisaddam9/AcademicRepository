@model RepositoryListViewModel
@{ ViewData["Title"] = Model.Scope.Label; }
<h1>@Model.Scope.Label</h1>
<p>Approved Academic Repository · Results are limited to your authorized scope.</p>
<form method="get" asp-action="Index" class="row g-3 mb-4">
<div class="col-md-4"><label for="repository-search" class="form-label">Search title or keywords</label><input id="repository-search" name="Search" value="@Model.Filter.Search" maxlength="200" class="form-control" /></div>
<div class="col-md-2"><label for="repository-type" class="form-label">Project Type</label><select id="repository-type" name="ProjectType" class="form-select"><option value="">All</option>
@foreach (var type in Enum.GetValues<ProjectType>()) { <option value="@((int)type)" selected="@(Model.Filter.ProjectType == type)">@Html.DisplayFor(_ => type)</option> }
</select></div>
<div class="col-md-2"><label for="repository-year" class="form-label">Academic Year</label><input id="repository-year" name="AcademicYear" value="@Model.Filter.AcademicYear" maxlength="30" class="form-control" /></div>
<div class="col-md-2"><label for="repository-semester" class="form-label">Semester</label><input id="repository-semester" name="Semester" value="@Model.Filter.Semester" maxlength="50" class="form-control" /></div>
<div class="col-md-2 align-self-end"><button class="btn btn-primary" type="submit">Search</button> <a asp-action="Index">Clear</a></div>
</form>
@if (Model.HasUnavailableRecords) { <p class="alert alert-warning">Some approved records in your scope are incomplete or unavailable and have been withheld. Contact your administrator.</p> }
<p>@Model.MatchingRecords matching approved records · Page @Model.Filter.Page of @Model.PageCount</p>
@if (Model.Items.Count == 0) { <p>No approved projects found on this page.</p> }
else
{
<div class="table-responsive"><table class="table table-striped"><thead><tr><th>Title</th><th>Student</th><th>Student ID</th><th>Department</th><th>Project Type</th><th>Academic Year</th><th>Semester</th><th>Supervisor</th><th>Approved (UTC)</th><th></th></tr></thead><tbody>
@foreach (var item in Model.Items)
{
<tr><td>@item.Title<br /><small>Approved Version @item.VersionNumber</small></td><td>@item.StudentName</td><td>@(item.StudentNumber ?? "Not recorded")</td><td>@item.Department</td><td>@Html.DisplayFor(_ => item.ProjectType)</td><td>@item.AcademicYear</td><td>@item.Semester</td><td>@item.Supervisor</td><td>@item.ApprovedAt.ToString("u")</td><td><a asp-action="Details" asp-route-id="@item.SubmissionId">View Details</a></td></tr>
}
</tbody></table></div>
}
<nav aria-label="Repository pages">
@if (Model.Filter.Page > 1) { <a class="btn btn-outline-primary" asp-action="Index" asp-route-Page="@(Model.Filter.Page - 1)" asp-route-Search="@Model.Filter.Search" asp-route-ProjectType="@Model.Filter.ProjectType" asp-route-AcademicYear="@Model.Filter.AcademicYear" asp-route-Semester="@Model.Filter.Semester">Previous</a> }
@if (Model.Filter.Page < Model.PageCount) { <a class="btn btn-outline-primary" asp-action="Index" asp-route-Page="@(Model.Filter.Page + 1)" asp-route-Search="@Model.Filter.Search" asp-route-ProjectType="@Model.Filter.ProjectType" asp-route-AcademicYear="@Model.Filter.AcademicYear" asp-route-Semester="@Model.Filter.Semester">Next</a> }
</nav>
