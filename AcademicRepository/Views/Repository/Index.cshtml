@model RepositoryListViewModel
@{
    ViewData["Title"] = Model.Scope.Label;
    var controller = Model.Scope.InstitutionWide ? "ORICQEC" : "Repository";
    var action = Model.Scope.InstitutionWide ? "Repository" : "Index";
    var typeOptions = new[] { new FilterOptionViewModel("", "All types") }.Concat(Enum.GetValues<ProjectType>().Select(t => new FilterOptionViewModel(((int)t).ToString(), t.ToString()))).ToArray();
    var fields = new List<FilterFieldViewModel>
    {
        new("Search", Model.Scope.ExtendedSearch ? "Search title, abstract, keywords, Student or supervisor" : "Search title or keywords", Model.Filter.Search, "search", "Search repository", 200),
        new("ProjectType", "Project Type", Model.Filter.ProjectType.HasValue ? ((int)Model.Filter.ProjectType.Value).ToString() : "", "select", Options: typeOptions),
        new("AcademicYear", "Academic Year", Model.Filter.AcademicYear, Model.Scope.ExtendedSearch ? "select" : "text", MaxLength: 30,
            Options: Model.Scope.ExtendedSearch ? new[] { new FilterOptionViewModel("", "All years") }.Concat((Model.AcademicYears ?? []).Select(y => new FilterOptionViewModel(y, y))).ToArray() : null),
        new("Semester", "Semester", Model.Filter.Semester, MaxLength: 50),
        new("Sort", "Sort by", ((int)Model.Filter.Sort).ToString(), "select", Options: new[] { new FilterOptionViewModel("0", "Newest approved"), new("1", "Oldest approved"), new("2", "Title A–Z"), new("3", "Title Z–A") })
    };
    if (Model.Scope.InstitutionWide) fields.Insert(1, new FilterFieldViewModel("DepartmentId", "Department", Model.Filter.DepartmentId?.ToString() ?? "", "select", Options: new[] { new FilterOptionViewModel("", "All departments") }.Concat((Model.Departments ?? []).Select(d => new FilterOptionViewModel(d.Id.ToString(), d.Name))).ToArray()));
    if (Model.Scope.ExtendedSearch) fields.Add(new FilterFieldViewModel("Supervisor", "Supervisor", Model.Filter.Supervisor, MaxLength: 150));
    var filter = new FilterPanelViewModel(action, controller, action, fields, Model.Results.PageSize, "Search");
    var route = new Dictionary<string, string> { ["Search"] = Model.Filter.Search ?? "", ["DepartmentId"] = Model.Filter.DepartmentId?.ToString() ?? "", ["ProjectType"] = Model.Filter.ProjectType?.ToString() ?? "", ["AcademicYear"] = Model.Filter.AcademicYear ?? "", ["Semester"] = Model.Filter.Semester ?? "", ["Supervisor"] = Model.Filter.Supervisor ?? "", ["Sort"] = ((int)Model.Filter.Sort).ToString(), ["pageSize"] = Model.Results.PageSize.ToString() };
    var pages = new PaginationViewModel(action, controller, Model.Results.PageNumber, Model.Results.PageSize, Model.Results.TotalCount, "Approved repository", route);
    var rows = Model.Items.Select(item => new DataTableRowViewModel(new DataTableCellViewModel[]
    {
        new($"{item.Title} · Approved Version {item.VersionNumber}"), new(item.StudentName), new(item.StudentNumber ?? "Not recorded"), new(item.Department), new(item.ProjectType.ToString()), new(item.AcademicYear ?? "—"), new(item.Semester ?? "—"), new(item.Supervisor ?? "—"), new(item.ApprovedAt.ToString("u"))
    }, new[] { new DataTableActionViewModel("View Details", Url.Action("Details", controller, new { id = item.SubmissionId }) ?? "#") })).ToArray();
    var table = new DataTableViewModel(action, controller, new[] { new DataTableColumnViewModel("Title"), new("Student"), new("Student ID"), new("Department"), new("Project Type"), new("Academic Year"), new("Semester"), new("Supervisor"), new("Approved (UTC)") }, rows, Model.Filter.Sort.ToString(), "desc", route, "No approved projects match your filters", "Adjust the search criteria or return to the default repository listing.", Url.Action(action, controller));
}
<h1>@Model.Scope.Label</h1>
<p>Approved Academic Repository · Results are limited to your authorized scope.</p>
<partial name="_FilterPanel" model="filter" />
@if (Model.Scope.InstitutionWide)
{
    <a class="btn btn-outline-success mb-3" asp-controller="ORICQEC" asp-action="Export" asp-all-route-data="route">Export CSV</a>
}
@if (Model.HasUnavailableRecords) { <p class="alert alert-warning">Some approved records in your scope do not meet the required review and version integrity checks and have been withheld. Contact your administrator.</p> }
<p>@Model.MatchingRecords matching approved records · Page @Model.Filter.Page of @Model.PageCount</p>
<partial name="_DataTable" model="table" />
<partial name="_Pagination" model="pages" />
