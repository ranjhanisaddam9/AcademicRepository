@model UserFormViewModel
@{ var editing = ViewContext.RouteData.Values["action"]?.ToString() == "Edit"; ViewData["Title"] = editing ? "Edit User" : "Create User"; }
<h1>@ViewData["Title"]</h1>
<form method="post" asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@ViewContext.RouteData.Values["id"]" style="max-width:600px">
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<input asp-for="EditToken" type="hidden" />
<div class="mb-3"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" maxlength="150" /></div>
<div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" maxlength="256" autocomplete="off" /></div>
<div class="mb-3"><label asp-for="Role" class="form-label"></label><select asp-for="Role" class="form-select"><option value="">Select a role</option>@foreach (var role in AcademicRepository.Data.IdentitySeeder.Roles) { <option value="@role">@role</option> }</select></div>
<div class="mb-3"><label asp-for="DepartmentId" class="form-label"></label><select asp-for="DepartmentId" asp-items="Model.Departments" class="form-select"><option value="">Not Assigned (Admin only)</option></select><div class="form-text">Required for Student, Coordinator and DepartmentHead.</div></div>
@if (!editing)
{
    <div class="mb-3"><label asp-for="TemporaryPassword" class="form-label"></label><input asp-for="TemporaryPassword" class="form-control" autocomplete="new-password" /><div class="form-text">At least six characters, including uppercase, lowercase, a digit and a special character.</div></div>
}
<button class="btn btn-primary">Save</button> <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>
