@model ResetPasswordViewModel
@{ ViewData["Title"] = "Reset Password"; }
<h1>Reset Password</h1><p>Set a new temporary password for @Model.UserName. Share it securely with the user.</p>
<form method="post" asp-action="ResetPassword" asp-route-id="@ViewContext.RouteData.Values["id"]" style="max-width:600px">
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="new-password" /><div class="form-text">At least six characters, including uppercase, lowercase, a digit and a special character.</div></div>
<button class="btn btn-primary">Reset Password</button> <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>
