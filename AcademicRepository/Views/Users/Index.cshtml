@model UserListPageViewModel
@{
    ViewData["Title"] = "Users";
    var fields = new List<FilterFieldViewModel>
    {
        new("search", "Name, email or Student ID", Model.Search, "search", "Search users", 200),
        new("role", "Role", Model.Role ?? "", "select", Options: new[] { new FilterOptionViewModel("", "All roles") }.Concat(AcademicRepository.Data.IdentitySeeder.Roles.Select(r => new FilterOptionViewModel(r, r))).ToArray()),
        new("departmentId", "Department", Model.DepartmentId?.ToString() ?? "", "select", Options: new[] { new FilterOptionViewModel("", "All departments") }.Concat(Model.Departments.Select(d => new FilterOptionViewModel(d.Value!, d.Text!))).ToArray()),
        new("isActive", "Account status", Model.IsActive?.ToString().ToLowerInvariant() ?? "", "select", Options: new[] { new FilterOptionViewModel("", "All statuses"), new("true", "Active"), new("false", "Inactive") })
    };
    var filter = new FilterPanelViewModel("Index", "Users", "Index", fields, Model.PageSize);
    var route = new Dictionary<string, string> { ["search"] = Model.Search ?? "", ["role"] = Model.Role ?? "", ["departmentId"] = Model.DepartmentId?.ToString() ?? "", ["isActive"] = Model.IsActive?.ToString().ToLowerInvariant() ?? "", ["pageSize"] = Model.PageSize.ToString(), ["direction"] = Model.Direction, ["sort"] = Model.Sort };
    var tableRows = Model.Users.Select(u => new DataTableRowViewModel(new DataTableCellViewModel[]
    {
        new(u.FullName), new(u.Email), new(u.StudentNumber ?? "—"), new(u.Role), new(u.Department), new(u.IsActive ? "Active" : "Inactive", u.IsActive ? "bg-success" : "bg-secondary")
    }, BuildActions(u))).ToArray();
    IReadOnlyList<DataTableActionViewModel> BuildActions(UserListItem u)
    {
        var actions = new List<DataTableActionViewModel>();
        if (!u.Role.Split(", ").Contains("Student"))
        {
            actions.Add(new("Edit staff", Url.Action("Edit", "Users", new { id = u.Id }) ?? "#"));
            actions.Add(new("Reset password", Url.Action("ResetPassword", "Users", new { id = u.Id }) ?? "#"));
        }
        actions.Add(new(u.IsActive ? "Deactivate" : "Activate", "#", "btn btn-sm btn-link text-start", "Users", "SetActive", u.Id, true, "isActive", (!u.IsActive).ToString().ToLowerInvariant()));
        return actions;
    }
    var table = new DataTableViewModel("Index", "Users", new[] { new DataTableColumnViewModel("Name", "Name"), new("Email", "Email"), new("Student ID", "StudentNumber"), new("Role"), new("Department"), new("Status") }, tableRows, Model.Sort, Model.Direction, route, "No users found", "Try changing your search or filters.", Url.Action("Index", "Users"));
    var pagination = new PaginationViewModel("Index", "Users", Model.Page, Model.PageSize, Model.Total, "User", route);
}
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Users</h1><a class="btn btn-primary" asp-action="Create">Create User</a></div>
<partial name="_FilterPanel" model="filter" />
<partial name="_DataTable" model="table" />
<partial name="_Pagination" model="pagination" />
