@model IReadOnlyList<UserListViewModel>
@{ ViewData["Title"] = "Users"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Users</h1><a class="btn btn-primary" asp-action="Create">Create User</a></div>
<div class="table-responsive"><table class="table table-striped"><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Department</th><th>Status</th><th>Actions</th></tr></thead><tbody>
@foreach (var user in Model)
{
    <tr><td>@user.FullName</td><td>@user.Email</td><td>@user.Role</td><td>@user.Department</td><td>@(user.IsActive ? "Active" : "Inactive")</td><td>
        <a asp-action="Edit" asp-route-id="@user.Id">Edit</a> | <a asp-action="ResetPassword" asp-route-id="@user.Id">Reset Password</a>
        <form class="d-inline ms-2" asp-action="SetActive" asp-route-id="@user.Id" method="post"><input type="hidden" name="isActive" value="@((!user.IsActive).ToString())" /><button class="btn btn-sm btn-outline-secondary">@(user.IsActive ? "Deactivate" : "Activate")</button></form>
    </td></tr>
}
</tbody></table></div>
@if (Model.Count == 0) { <p>No users match this list.</p> }
